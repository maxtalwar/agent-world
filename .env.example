# OpenRouterBrain uses OpenRouter Chat Completions and defaults to GLM-5.2.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_MAX_OUTPUT_TOKENS=8000
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_MAX_RETRIES=4
OPENROUTER_MIN_REQUEST_INTERVAL_SECONDS=0.5
OPENROUTER_MAX_PARALLEL_AGENTS=1
# Stops the main run promptly even if a timed-out HTTP worker is still stuck.
OPENROUTER_HARD_DEADLINE_GRACE_SECONDS=30
# Pin OpenRouter routing to reliable hosts (comma-separated; improves latency and prompt-cache hits).
OPENROUTER_PROVIDER_ORDER=Z.AI,Alibaba,StreamLake,Parasail
SSL_CERT_FILE=/etc/ssl/cert.pem

# Optional ChatGPT-plan-backed CodexBrain settings. The child process deliberately
# ignores API-key variables and uses the saved `codex login` session. OpenAI
# models such as gpt-5.4-mini route here by default.
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=300
CODEX_TIMEOUT_RETRIES=1
CODEX_MAX_PARALLEL_AGENTS=1
# Account-level snapshots are diagnostic only; exact run credits come from per-call usage.
# 0 = start/end only; set a positive interval for additional diagnostic snapshots.
CODEX_PLAN_SNAPSHOT_INTERVAL_TICKS=0
CLAUDE_TIMEOUT_RETRIES=1

# Optional Cursor-subscription-backed CursorBrain settings. Browser login is
# stored by Cursor outside this repository; never put CURSOR_API_KEY here.
CURSOR_MODEL=cursor-grok-4.5
CURSOR_REASONING_EFFORT=low
CURSOR_TIMEOUT_SECONDS=300
CURSOR_TIMEOUT_RETRIES=1
CURSOR_MAX_PARALLEL_AGENTS=1

# Optional Windsurf/Devin-subscription-backed WindsurfBrain settings. The
# connector uses Devin CLI's ACP server and saved browser login. Legacy Windsurf
# Enterprise users can select Windsurf during `devin auth login`. Never put a
# WINDSURF_API_KEY or DEVIN_API_KEY here.
WINDSURF_MODEL=swe-1-6-fast
WINDSURF_REASONING_EFFORT=low
WINDSURF_TIMEOUT_SECONDS=300
WINDSURF_TIMEOUT_RETRIES=1
WINDSURF_MAX_PARALLEL_AGENTS=1
# Override only when `devin` is not discoverable on PATH or in its app bundle.
# WINDSURF_EXECUTABLE=/absolute/path/to/devin
