#!/usr/bin/env python3
"""Record reviewed execution baselines; run only after compatibility validation."""
import hashlib
import json
import sys
from pathlib import Path
root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root))
from agent_world.protocols import RECIPES
from agent_world.benchmarks import BENCHMARK_FINGERPRINT_FILES
files = {"agent_world/" + n for n in BENCHMARK_FINGERPRINT_FILES}
files.update(str(p.relative_to(root)) for p in (root / "agent_world/world_revisions").rglob("*.py"))
files.update("agent_world/" + n for n in ["outcome_scoring.py", "production_scoring.py", "recipe_execution.py"])
value = {"schema_version": 1,
         "files": {n: hashlib.sha256((root/n).read_bytes()).hexdigest() for n in sorted(files)},
         "recipes": {r.id: {"recipe_digest": r.digest} for r in RECIPES.values()}}
(root / "agent_world/recipe-execution-locks.json").write_text(json.dumps(value, indent=2) + "\n")
