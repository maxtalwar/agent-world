# Default: OpenRouter (OpenAI-compatible Chat Completions API) running GLM-5.2.
# The brain auto-selects the Chat Completions style when the base URL is OpenRouter.
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
OPENAI_MODEL=z-ai/glm-5.2
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_RETRIES=4
OPENAI_MIN_REQUEST_INTERVAL_SECONDS=0.5
OPENAI_MAX_PARALLEL_AGENTS=1
# Stops the main run promptly even if a timed-out HTTP worker is still stuck.
OPENAI_HARD_DEADLINE_GRACE_SECONDS=30
# Pin OpenRouter routing to reliable hosts (comma-separated; improves latency and prompt-cache hits).
OPENAI_PROVIDER_ORDER=Z.AI,Alibaba,StreamLake,Parasail
SSL_CERT_FILE=/etc/ssl/cert.pem

# To use OpenAI's Responses API instead, set:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-5.4-mini
# The request style auto-detects from the base URL; override with LLM_API_STYLE=chat|responses.

# Optional ChatGPT-plan-backed CodexBrain settings. The child process deliberately
# ignores API-key variables and uses the saved `codex login` session.
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=300
CODEX_TIMEOUT_RETRIES=1
CODEX_MAX_PARALLEL_AGENTS=1
# Account-level snapshots are diagnostic only; exact run credits come from per-call usage.
# 0 = start/end only; set a positive interval for additional diagnostic snapshots.
CODEX_PLAN_SNAPSHOT_INTERVAL_TICKS=0
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_REASONING_EFFORT=low
CLAUDE_MAX_THINKING_TOKENS=0
CLAUDE_TIMEOUT_SECONDS=300
CLAUDE_TIMEOUT_RETRIES=1
CLAUDE_MAX_PARALLEL_AGENTS=1
